{
  "name": "js-tracker",
  "version": "2.2.1-beta",
  "description": "Client Side xAPI-SG Tracker Asset written in JavaScript",
  "type": "module",
  "main": "dist/js-tracker.bundle.cjs",
  "module": "dist/js-tracker.bundle.js",
  "types": "dist/types/js-tracker.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/js-tracker.d.ts",
      "import": "./dist/js-tracker.bundle.js",
      "require": "./dist/js-tracker.bundle.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/e-ucm/js-tracker",
  "author": "e-UCM Research Group",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:profiles": "git submodule update --init --recursive && node scripts/generateProfiles.js",
    "docs:reference": "node scripts/generateApiReference.js",
    "build:types": "npx tsc --project tsconfig.json",
    "build:webpack": "webpack && rollup -c",
    "build": "npm run build:webpack && npm run build:types",
    "prepare": "npm run build",
    "typecheck": "npx tsc --noEmit --project tsconfig.json",
    "verify": "npm run typecheck && npm run test && npm run build",
    "eslint-fix": "eslint . --fix",
    "lint": "eslint . && npm run eslint-fix",
    "test": "npm run lint && mocha",
    "test-travis": "npm run lint && ./node_modules/istanbul/lib/cli.js cover ./node_modules/mocha/bin/_mocha -- --recursive -R spec"
  },
  "dependencies": {
    "@xapi/xapi": "3.0.0",
    "jwt-decode": "^4.0.0",
    "ms": "^2.1.3",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^25.6.0",
    "axios": "^1.9.0",
    "babel-loader": "9.1.3",
    "chai": "^5.1.1",
    "eslint": "^9.5.0",
    "eslint-plugin-node": "^11.1.0",
    "istanbul": "0.4.5",
    "lodash.clonedeep": "^4.5.0",
    "mocha": "^11.3.0",
    "moment": "2.30.1",
    "rollup": "^4.44.1",
    "rollup-plugin-glslify": "^1.0.0",
    "terser-webpack-plugin": "^5.4.0",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "5.1.4"
  }
}
