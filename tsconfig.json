{
    "compilerOptions": {
        "allowJs": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist/types",
        "rootDir": "./src",
        "checkJs": true,
        "moduleResolution": "node10",
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2021",
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true
    },
    "include": [
        "declarations.d.ts",
        "src/**/*"
    ],
    "exclude": [
        "dist"
    ]
}